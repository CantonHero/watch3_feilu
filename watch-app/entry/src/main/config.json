{
  "app": {
    "bundleName": "com.hero.watchvoice.archive",
    "vendor": "Hero",
    "version": {
      "code": 18,
      "name": "0.3.15"
    },
    "apiVersion": {
      "compatible": 6,
      "target": 6,
      "releaseType": "Release"
    }
  },
  "deviceConfig": {},
  "module": {
    "package": "com.hero.watchvoice.archive",
    "name": ".WatchVoiceApplication",
    "mainAbility": "com.hero.watchvoice.archive.MainAbility",
    "deviceType": [
      "wearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry",
      "installationFree": false
    },
    "abilities": [
      {
        "name": "com.hero.watchvoice.archive.MainAbility",
        "label": "$string:watch_app_name",
        "description": "$string:app_name",
        "icon": "$media:app_icon",
        "type": "page",
        "launchType": "standard",
        "visible": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:watch_mic_reason",
        "usedScene": {
          "ability": [
            "com.hero.watchvoice.archive.MainAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
